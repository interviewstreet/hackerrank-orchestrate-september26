# ── Buy or Wait? — Environment Variable Template ─────────────────────────────
# Copy this file to .env and fill in your values. NEVER commit .env.
# Only GEMINI_API_KEY is required. All other variables have safe defaults.

# REQUIRED: Your Google Gemini API key
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LiteLLM model identifier (default: gemini-1.5-flash)
# Other valid values: gemini/gemini-1.5-pro, gemini/gemini-2.0-flash
MODEL_NAME=gemini/gemini-1.5-flash

# LLM temperature for structured extraction (0 = deterministic)
MODEL_TEMPERATURE=0.0

# Path to the dataset directory
DATASET_DIR=dataset

# Path for the output predictions file
OUTPUT_PATH=dataset/output.csv

# Path for the persistent OCR cache (avoids re-running vision on same images)
OCR_CACHE_PATH=code/evidence/ocr_cache.json

# Number of parallel async workers for request evaluation
MAX_WORKERS=8

# Fixed random seed for reproducibility
RANDOM_SEED=42

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
